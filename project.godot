[layer_names]

3d_render/layer_10="players"
3d_render/layer_11="shroud"
3d_render/layer_12="outside"
3d_physics/layer_1="world"
3d_physics/layer_2="enemy"
3d_physics/layer_3="interactable"
3d_physics/layer_4="player"
3d_physics/layer_5="clickable"
3d_physics/layer_6="zones"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

